BOT_TOKEN=your_bot_token_here
REQUIRED_CHANNEL_USERNAME=your_channel_username
SUPPORT_USERNAME=your_support_username
ADMIN_IDS=123456789,987654321
UPI_ID=your_upi_id_here

# Webhook / Render
# HTTPS URL Telegram can reach (your deployed app / a local tunnel).
WEBHOOK_BASE_URL=https://your-app.onrender.com
PORT=8080
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PATH=/webhook
# Optional, but recommended. Any random string. Telegram will sign requests with it.
WEBHOOK_SECRET=your_random_webhook_secret